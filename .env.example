# Basescan API Key
# Get your API key from: https://basescan.org/myapikey
NEXT_PUBLIC_BASESCAN_API_KEY=YourBasescanApiKeyHere

# OnchainKit Configuration (if not already set)
# NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_onchainkit_api_key

# Donation Contract Address (after deployment)
# Leave empty if not deployed yet
NEXT_PUBLIC_DONATION_CONTRACT=

# For contract deployment only (DO NOT commit this file with real keys)
PRIVATE_KEY=your_wallet_private_key_for_deployment
BASESCAN_API_KEY=your_basescan_api_key_for_verification
